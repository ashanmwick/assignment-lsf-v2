# Supabase Postgres connection string.
# For running `npm run migrate`, use the DIRECT connection (port 5432), not the
# Supavisor pooler (port 6543) — DDL should run against the direct connection.
# Normal app query traffic (npm run dev / npm start) can use either.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Port the Express API listens on.
PORT=4000

# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGIN=http://localhost:5173

# How long a newly-created booking stays in 'held' status before it is
# eligible for the sweeper to cancel it, in minutes.
HOLD_DURATION_MINUTES=7

# How often the background sweeper checks for expired holds, in seconds.
SWEEPER_INTERVAL_SECONDS=30
