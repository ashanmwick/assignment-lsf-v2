# Used only by docker-compose.yml, and only if you want it to talk to a real
# Supabase project instead of the local Postgres container it starts by
# default. Leave this file absent (or this line commented out) to use the
# local db service -- that's the zero-setup path.
#
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
